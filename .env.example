# 复制为 .env 后填写；.env 不会进 git，也不会打进镜像
# Tushare Pro token：https://tushare.pro/user/token
# 不填也能启动：自动回退到 akshare（首次拉股票列表/行情会更慢）
TUSHARE_TOKEN=

# auto / tushare / akshare
QUANT_DATA_SOURCE=auto

# 宿主机端口；被占用时改成 8001 等
PORT=8000

# 可选：基础镜像无法从 Docker Hub 拉取时替换（默认官方镜像）
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.13-slim-bookworm

# 可选：构建时前端依赖的源（国内可换 npmmirror）
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---------------- 在线版本更新（deploy-ecs.sh 自动生成/设置，一般无需手动改） ----------------
# 页面触发更新时输入的令牌（deploy-ecs.sh 随机生成；查看：grep UPDATE_TOKEN .env）
# UPDATE_TOKEN=
# host-updater = 启用宿主机在线更新服务；none = 本地开发模式（页面只读）
# UPDATE_MODE=none
# 使用的镜像 tag（更新器会自动改写；latest = 最新正式版）
# IMAGE_TAG=latest
# 可选：GitHub API token，提高版本检测限额（匿名 60 次/小时，一般够用）
# GITHUB_TOKEN=
